# Choose one provider.
# - gemini: direct REST calls to /v1beta/interactions (lib/geminiInteractions.ts)
# - openai: AI SDK via lib/llm.ts
LLM_PROVIDER=gemini        # "openai" | "gemini"

OPENAI_API_KEY=sk-...
GOOGLE_GENERATIVE_AI_API_KEY=...   # used when LLM_PROVIDER=gemini

# Optional: only needed if you hit GitHub's unauthenticated API rate limit
# (60 req/hr per IP) while validating repos in lib/git.ts.
GITHUB_TOKEN=

OPENROUTER_API_KEY= 
